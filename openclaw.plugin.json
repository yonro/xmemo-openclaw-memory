{
  "id": "xmemo-memory",
  "name": "XMemo for OpenClaw",
  "description": "Native XMemo cloud-memory provider for OpenClaw agents: long-term memory, semantic recall, TODOs, snapshots, and audit tools. Pair with the XMemo Skill for recall-first workflow guidance.",
  "kind": "memory",
  "commandAliases": [
    {
      "name": "xmemo",
      "cliCommand": "xmemo"
    }
  ],
  "activation": {
    "onStartup": true,
    "onCommands": [
      "xmemo",
      "memory"
    ]
  },
  "setup": {
    "providers": [
      {
        "id": "xmemo-memory",
        "authMethods": ["api-key", "bearer", "device-code"],
        "envVars": ["XMEMO_KEY", "MEMORY_OS_API_KEY", "MEMORY_OS_MCP_TOKEN"]
      }
    ],
    "requiresRuntime": false
  },
  "providerAuthChoices": [
    {
      "provider": "xmemo-memory",
      "method": "device-code",
      "choiceId": "xmemo-device-code",
      "choiceLabel": "XMemo Browser Login (OAuth / Device Flow)",
      "choiceHint": "Authorize via browser at xmemo.dev (openclaw xmemo login)",
      "groupId": "xmemo",
      "groupLabel": "XMemo",
      "groupHint": "Browser login (interactive)",
      "cliFlag": "--xmemo-login",
      "cliOption": "--xmemo-login",
      "cliDescription": "Log in via browser at xmemo.dev"
    },
    {
      "provider": "xmemo-memory",
      "method": "api-key",
      "choiceId": "xmemo-api-key",
      "appGuidedSecret": true,
      "choiceLabel": "XMemo API key",
      "choiceHint": "Register at https://xmemo.dev to get an API key",
      "groupId": "xmemo",
      "groupLabel": "XMemo",
      "groupHint": "API key (recommended)",
      "optionKey": "xmemoApiKey",
      "cliFlag": "--xmemo-api-key",
      "cliOption": "--xmemo-api-key <key>",
      "cliDescription": "XMemo API key"
    },
    {
      "provider": "xmemo-memory",
      "method": "bearer",
      "choiceId": "xmemo-bearer-token",
      "appGuidedSecret": true,
      "choiceLabel": "XMemo Bearer token",
      "groupId": "xmemo",
      "groupLabel": "XMemo",
      "groupHint": "Bearer token or JWT",
      "optionKey": "xmemoBearerToken",
      "cliFlag": "--xmemo-bearer-token",
      "cliOption": "--xmemo-bearer-token <token>",
      "cliDescription": "XMemo Bearer token"
    }
  ],
  "contracts": {
    "tools": [
      "memory_search",
      "memory_get",
      "memory_store",
      "memory_forget",
      "xmemo_memory_list",
      "xmemo_memory_get",
      "xmemo_memory_update",
      "xmemo_todo_create",
      "xmemo_todo_list",
      "xmemo_todo_complete",
      "xmemo_record_event",
      "xmemo_restart_snapshot_save",
      "xmemo_restart_snapshot_restore",
      "xmemo_ledger_monthly_summary",
      "xmemo_audit_events",
      "xmemo_audit_consolidation"
    ]
  },
  "toolMetadata": {
    "memory_search": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "memory_get": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "memory_store": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "memory_forget": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_memory_list": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_memory_get": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_memory_update": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_todo_create": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_todo_list": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_todo_complete": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_record_event": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_restart_snapshot_save": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_restart_snapshot_restore": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_ledger_monthly_summary": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_audit_events": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_audit_consolidation": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "XMemo Service URL",
      "placeholder": "https://xmemo.dev",
      "help": "Hosted XMemo service is at https://xmemo.dev. Change only for private/self-hosted instances.",
      "advanced": false
    },
    "apiKey": {
      "label": "XMemo API Key",
      "placeholder": "xmemo_...",
      "help": "Register and obtain your API key at https://xmemo.dev. Alternatively, set XMEMO_KEY in environment, or run `openclaw xmemo login` in terminal for one-click browser authorization.",
      "sensitive": true,
      "advanced": false
    },
    "token": {
      "label": "XMemo Token (deprecated)",
      "placeholder": "xmemo_...",
      "help": "Deprecated alias for apiKey. Prefer apiKey or the XMEMO_KEY environment variable.",
      "sensitive": true,
      "advanced": true
    },
    "authMode": {
      "label": "Header Transport",
      "placeholder": "api-key",
      "help": "HTTP header format: api-key (X-API-Key header, recommended) or bearer (Authorization: Bearer). Default: api-key.",
      "advanced": true
    },
    "bucket": {
      "label": "Default Bucket",
      "placeholder": "openclaw",
      "help": "Default bucket for memories created by OpenClaw.",
      "advanced": true
    },
    "scope": {
      "label": "Default Scope",
      "placeholder": "openclaw",
      "help": "Optional scope for memories created by OpenClaw.",
      "advanced": true
    },
    "readBucket": {
      "label": "Read Bucket",
      "placeholder": "%",
      "help": "Advanced read filter for recall/search. Keep % to search all visible user-owned XMemo buckets.",
      "advanced": true
    },
    "readScope": {
      "label": "Read Scope",
      "placeholder": "",
      "help": "Advanced read filter for recall/search. Leave empty to use the token default.",
      "advanced": true
    },
    "teamId": {
      "label": "Team ID",
      "placeholder": "",
      "help": "Optional team/organization id for enterprise XMemo deployments.",
      "advanced": true
    },
    "agentId": {
      "label": "Agent ID",
      "placeholder": "openclaw",
      "help": "Advanced attribution override. Defaults to openclaw.",
      "advanced": false
    },
    "autoCapture": {
      "label": "Auto-Capture",
      "help": "Automatically extract facts and preferences from conversation ends into XMemo cloud without manual tool invocations.",
      "advanced": false
    },
    "captureMaxChars": {
      "label": "Capture Max Chars",
      "help": "Maximum message length eligible for auto-capture.",
      "advanced": true,
      "placeholder": "500"
    },
    "customTriggers": {
      "label": "Custom Auto-Capture Triggers",
      "help": "Additional words or phrases that trigger auto-capture (case-insensitive).",
      "advanced": true
    },
    "recallMaxChars": {
      "label": "Recall Query Max Chars",
      "help": "Maximum prompt/query length sent to XMemo for recall.",
      "advanced": true,
      "placeholder": "1000"
    },
    "recallMaxItems": {
      "label": "Recall Max Items",
      "help": "Maximum number of memories returned by XMemo recall.",
      "advanced": true,
      "placeholder": "15"
    },
    "recallMaxTokens": {
      "label": "Recall Max Tokens",
      "help": "Maximum token budget for the recalled context package.",
      "advanced": true,
      "placeholder": "12000"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "format": "uri",
        "default": "https://xmemo.dev"
      },
      "apiKey": {
        "type": ["string", "object"],
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "enum": ["env"] },
              "provider": { "type": "string" },
              "id": { "type": "string" }
            },
            "required": ["source", "provider", "id"]
          }
        ]
      },
      "token": {
        "type": ["string", "object"],
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "enum": ["env"] },
              "provider": { "type": "string" },
              "id": { "type": "string" }
            },
            "required": ["source", "provider", "id"]
          }
        ]
      },
      "authMode": {
        "type": "string",
        "enum": ["api-key", "bearer", "both"],
        "default": "api-key"
      },
      "bucket": {
        "type": "string",
        "default": "openclaw"
      },
      "scope": {
        "type": ["string", "null"]
      },
      "readBucket": {
        "type": "string",
        "default": "%"
      },
      "readScope": {
        "type": ["string", "null"]
      },
      "teamId": {
        "type": ["string", "null"]
      },
      "agentId": {
        "type": "string",
        "default": "openclaw"
      },
      "autoCapture": {
        "type": "boolean",
        "default": true
      },
      "captureMaxChars": {
        "type": "number",
        "minimum": 100,
        "maximum": 10000,
        "default": 500
      },
      "customTriggers": {
        "type": "array",
        "items": { "type": "string" }
      },
      "recallMaxChars": {
        "type": "number",
        "minimum": 100,
        "maximum": 10000,
        "default": 1000
      },
      "recallMaxItems": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 8
      },
      "recallMaxTokens": {
        "type": "integer",
        "minimum": 100,
        "maximum": 64000,
        "default": 12000
      }
    }
  }
}
