{
  "id": "xmemo-memory",
  "name": "XMemo for OpenClaw",
  "description": "Native XMemo cloud-memory provider for OpenClaw agents: long-term memory, semantic recall, TODOs, snapshots, and audit tools. Pair with the XMemo Skill for recall-first workflow guidance.",
  "kind": "memory",
  "activation": {
    "onStartup": false,
    "onCommands": ["memory"]
  },
  "setup": {
    "providers": [
      {
        "id": "xmemo-memory",
        "authMethods": ["api-key", "bearer"],
        "envVars": ["XMEMO_KEY", "MEMORY_OS_API_KEY", "MEMORY_OS_MCP_TOKEN"]
      }
    ],
    "requiresRuntime": false
  },
  "contracts": {
    "tools": [
      "memory_search",
      "memory_get",
      "memory_store",
      "memory_forget",
      "xmemo_memory_list",
      "xmemo_memory_update",
      "xmemo_todo_create",
      "xmemo_todo_list",
      "xmemo_todo_complete",
      "xmemo_record_event",
      "xmemo_restart_snapshot_save",
      "xmemo_restart_snapshot_restore",
      "xmemo_ledger_monthly_summary",
      "xmemo_audit_events",
      "xmemo_audit_consolidation"
    ]
  },
  "toolMetadata": {
    "memory_search": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "memory_get": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "memory_store": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "memory_forget": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_memory_list": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_memory_update": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_todo_create": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_todo_list": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_todo_complete": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_record_event": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_restart_snapshot_save": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_restart_snapshot_restore": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_ledger_monthly_summary": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_audit_events": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    },
    "xmemo_audit_consolidation": {
      "authSignals": [{ "provider": "xmemo-memory" }],
      "configSignals": [
        {
          "rootPath": "plugins.entries.xmemo-memory.config",
          "requiredAny": ["apiKey", "token"]
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "format": "uri"
      },
      "apiKey": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "enum": ["env"] },
              "provider": { "type": "string" },
              "id": { "type": "string" }
            },
            "required": ["source", "provider", "id"]
          }
        ]
      },
      "token": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "enum": ["env"] },
              "provider": { "type": "string" },
              "id": { "type": "string" }
            },
            "required": ["source", "provider", "id"]
          }
        ]
      },
      "authMode": {
        "type": "string",
        "enum": ["api-key", "bearer", "both"],
        "default": "api-key"
      },
      "bucket": {
        "type": "string",
        "default": "openclaw"
      },
      "scope": {
        "type": ["string", "null"]
      },
      "readBucket": {
        "type": "string",
        "default": "%"
      },
      "readScope": {
        "type": ["string", "null"]
      },
      "teamId": {
        "type": ["string", "null"]
      },
      "agentId": {
        "type": "string",
        "default": "openclaw"
      },
      "autoCapture": {
        "type": "boolean",
        "default": false
      },
      "captureMaxChars": {
        "type": "number",
        "minimum": 100,
        "maximum": 10000,
        "default": 500
      },
      "customTriggers": {
        "type": "array",
        "items": { "type": "string" }
      },
      "recallMaxChars": {
        "type": "number",
        "minimum": 100,
        "maximum": 10000,
        "default": 1000
      },
      "recallMaxItems": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 8
      },
      "recallMaxTokens": {
        "type": "integer",
        "minimum": 100,
        "maximum": 8000,
        "default": 4000
      }
    }
  }
}
